  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "requests": {},
        "exec": [
          "// HMAC Signature Generation",
          "const CryptoJS = require('crypto-js');",
          "",
          "// Get API key from environment",
          "const apiKey = pm.environment.get('CHECKR_API_KEY') || pm.variables.get('apiKey');",
          "",
          "// Get request body",
          "const requestBody = pm.request.body.raw;",
          "",
          "// Create HMAC signature",
          "const message = apiKey + requestBody;",
          "const signature = CryptoJS.HmacSHA256(message, apiKey).toString();",
          "",
          "// Set signature in variable",
          "pm.variables.set('hmac_signature', signature);",
          "",
          "console.log('Generated HMAC signature:', signature);"
        ]
      }
    },
